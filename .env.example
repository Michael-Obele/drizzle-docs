# Docs source. Point this at a mirror or an internal docs site if you need to.
DOCS_BASE_URL=https://orm.drizzle.team

# How long a fetched page/index stays in memory before it is refetched (ms).
DOCS_CACHE_TTL_MS=3600000

# Transport: stdio (default, for npx/local editors) or http (self-hosted).
MCP_TRANSPORT=stdio

# HTTP transport only: where the Streamable HTTP endpoint is served.
PORT=3000
HOST=0.0.0.0
MCP_PATH=/mcp
