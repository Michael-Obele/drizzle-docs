{
  "name": "drizzle-docs-mcp",
  "version": "3.0.0",
  "description": "MCP server for the Drizzle ORM documentation: 450+ pages across 6 SQL dialects with fuzzy and full-text search, over stdio (npx) or Streamable HTTP (self-hosted).",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Michael-Obele/drizzle-docs.git"
  },
  "homepage": "https://github.com/Michael-Obele/drizzle-docs#readme",
  "bugs": {
    "url": "https://github.com/Michael-Obele/drizzle-docs/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "drizzle",
    "drizzle-orm",
    "orm",
    "documentation",
    "docs",
    "llms-txt",
    "ai",
    "llm",
    "tmcp"
  ],
  "bin": {
    "drizzle-docs-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "MCP_ARCHITECTURE.md"
  ],
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "dev:http": "bun --watch src/index.ts --http",
    "start": "bun src/index.ts",
    "start:http": "bun src/index.ts --http",
    "check": "tsc --noEmit",
    "test": "bun test",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run check && bun run test && bun run build"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@tmcp/adapter-zod": "^0.1.8",
    "@tmcp/transport-http": "^0.9.0",
    "@tmcp/transport-stdio": "^0.5.0",
    "cheerio": "^1.2.0",
    "fuse.js": "^7.1.0",
    "srvx": "^1.0.5",
    "tmcp": "^1.20.0",
    "turndown": "^7.2.2",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/node": "^24.0.15",
    "@types/turndown": "^5.0.6",
    "typescript": "^5.9.3"
  }
}
